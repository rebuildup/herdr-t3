{
  "name": "herdr-t3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Herdr session GUI client with the T3 Code design system (macOS/Windows)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebuildup/herdr-t3.git"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "server": "bun run server/index.ts",
    "start": "bun run build && bun run server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "bun@1.4.4"
}
