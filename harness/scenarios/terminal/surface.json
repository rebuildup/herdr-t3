        "cols": 20,
        "rows": 6,
        "cell_w": 10,
        "cell_h": 20,
        "scrollback_lines": 50,
        "colors": {
          "foreground": "#eeeeee",
          "background": "#101010",
          "cursor": "#ffcc00",
          "ansi": [
            "#000000",
            "#cc0000",
            "#00cc00",
            "#cccc00",
            "#0000cc",
            "#cc00cc",
            "#00cccc",
            "#cccccc",
            "#666666",
            "#ff6666",
            "#66ff66",
            "#ffff66",
            "#6666ff",
            "#ff66ff",
            "#66ffff",
            "#ffffff"
          ]
