            },
            {
              "type": "resize",
              "cols": 20,
              "rows": 6
            },
            {
              "type": "schedule"
            }
          ],
          "value": null
        }
      }
    },
    {
      "op": "surface_write",
      "input": {
        "text": "l0\r\nl1\r\nl2\r\nl3\r\nl4\r\nl5\r\nl6\r\nl7\r\nl8\r\nl9"
