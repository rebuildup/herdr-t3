{
  "format": "herdr-t3/ui-scenario",
  "version": 1,
  "id": "shell.goto-picker-navigation",
  "capability": "ui.goto-picker",
  "contract": "ui-shell@1",
  "fixture": "goto-picker",
  "os": ["macos", "windows-11"],
  "note": "Go to picker slice of boundary 5 (#328). Both adapters see the same seeded shape: two workspaces (ui-a/ui-b), one tab + one agent-less pane each -> 6 rows unfiltered, 3 rows under a ui-b query, 0 under a nomatch query. Row ids differ across adapters (herdr assigns workspace ids), so rows are resolved via enumerate(\"goto.row\") ordinals; state.focused_pane compares against the mounted-pane ordinal, the same semantic on both sides.",
  "steps": [
    { "assert": "state.goto_open", "equals": false },
    { "action": "activate", "target": "nav.goto" },
    { "wait": { "until": "state.goto_open", "equals": true, "timeout_ms": 8000 } },
    { "assert": "goto.query", "equals": "" },
    { "assert": "goto.row_count", "equals": 6 },
    { "action": "type", "target": "goto.input", "params": { "text": "ui-b" } },
    { "wait": { "until": "goto.row_count", "equals": 3, "timeout_ms": 5000 } },
    { "assert": "goto.query", "equals": "ui-b" },
    { "assert": "goto.row_count", "equals": 3 },
    { "action": "select", "target": "goto.row", "params": { "id": "$third" } },
    { "wait": { "until": "state.goto_open", "equals": false, "timeout_ms": 5000 } },
    { "wait": { "until": "state.selected_workspace", "equals": "$second", "timeout_ms": 10000 } },
    { "assert": "state.selected_workspace", "equals": "$second" },
    { "wait": { "until": "state.focused_pane", "equals": "$first", "timeout_ms": 10000 } },
    { "assert": "state.focused_pane", "equals": "$first" },
    { "action": "activate", "target": "nav.goto" },
    { "wait": { "until": "state.goto_open", "equals": true, "timeout_ms": 8000 } },
    { "assert": "goto.query", "equals": "ui-b" },
    { "assert": "goto.row_count", "equals": 3 },
    { "action": "type", "target": "goto.input", "params": { "text": "zzz-nomatch" } },
    { "wait": { "until": "goto.row_count", "equals": 0, "timeout_ms": 5000 } },
    { "assert": "goto.row_count", "equals": 0 },
    { "action": "dismiss", "target": "goto.dialog" },
    { "wait": { "until": "state.goto_open", "equals": false, "timeout_ms": 5000 } },
    { "assert": "state.selected_workspace", "equals": "$second" }
  ]
}
