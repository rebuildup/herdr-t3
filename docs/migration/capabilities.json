      "id": "protocol-frames",
      "version": 1,
      "title": "Wire protocol frames and attach codec",
      "spec": "docs/migration/contracts/protocol-frames.md",
      "oracle": "conformance",
      "summary": "ClientFrame/ServerFrame, snapshot/revision semantics, attach codec, additive tolerance."
    },
    {
      "id": "bridge-session",
      "version": 1,
      "title": "Bridge session lifecycle",
      "spec": "docs/migration/contracts/bridge-session.md",
      "oracle": "differential",
      "summary": "Connect/subscribe/attach/reconnect, one-RPC-per-call, draft invariant, attach-stream truth."
    },
    {
      "id": "machines-transport",
      "version": 1,
      "title": "Machines and transports",
      "spec": "docs/migration/contracts/machines-transport.md",
      "oracle": "differential",
      "summary": "Machine CRUD/connect, local/SSH/Windows named-pipe routing, probe snapshots."
    },
    {
      "id": "plugins-boundary",
      "version": 1,
      "title": "herdr-plugins contract boundary",
      "spec": "docs/migration/contracts/plugins-boundary.md",
      "oracle": "conformance",
      "summary": "plugin_list/plugin_call, per-host capability gating, error-kind passthrough, no state-file reads."
    },
    {
      "id": "workspace-pane-ops",
      "version": 1,
      "title": "Workspace/tab/pane/agent/worktree operations",
      "spec": "docs/migration/contracts/workspace-pane-ops.md",
      "oracle": "differential",
      "summary": "RPC_METHODS surface, snapshot-derived views, ordering semantics, agent prompt API."
    },
    {
      "id": "agent-inbox",
      "version": 1,
      "title": "Agent projection, inbox organize, attention",
      "spec": "docs/migration/contracts/agent-inbox.md",
      "oracle": "conformance",
      "summary": "Shelves, row projection, plugin-owned organize state, attention notices."
    },
    {
      "id": "terminal-session",
      "version": 1,
      "title": "Terminal session lifecycle",
      "spec": "docs/migration/contracts/terminal-session.md",
      "oracle": "differential",
      "summary": "Attach vs mirror, resize authority, sync output, mouse-capture push; byte I/O per docs/design/terminal-io.md."
    },
    {
      "id": "settings-persistence",
      "version": 1,
      "title": "Settings and persistence",
      "spec": "docs/migration/contracts/settings-persistence.md",
      "oracle": "conformance",
      "summary": "Single-owner settings keys, drafts, userData profile, legacy overlay migration.",
      "evidence": ["docs/migration/persistence-compatibility.md", "src/lib/persistence-compat.test.ts", "src/lib/settings.test.ts", "docs/design/evidence/90/manifest.json"]
    },
    {
      "id": "ui-shell",
      "version": 1,
      "title": "UI shell semantics",
      "spec": "docs/migration/contracts/ui-shell.md",
      "oracle": "conformance",
      "summary": "T3 shell semantics: actions, focus, motion, theme roles, window chrome — implementation-independent."
    },
    {
      "id": "distribution",
      "version": 1,
      "title": "Distribution and OS integration",
      "spec": "docs/migration/contracts/distribution.md",
      "oracle": "manual",
      "summary": "electron-builder artifacts, pc-setup install/update/rollback, userData, diagnostics."
    }
  ],
