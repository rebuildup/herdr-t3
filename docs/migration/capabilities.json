{
  "schema_version": 1,
  "description": "herdr-t3 GPUI migration capability registry (issue #235, ADR-0013). Single machine-readable ledger of every current and planned capability. Stage axis tracks migration progress; status axes track implementation health independently. See docs/migration/README.md.",
  "stages": [
    "not-started",
    "contract-defined",
    "current-verified",
    "rust-implemented",
    "equivalence-verified",
    "switched",
    "removed"
